# Keep the Docker image small — only ship what the CLI needs to run.
# Kept in step with .gitignore's own artifact list -- no reason for the two
# to diverge without cause.
.git
.github
.venv
venv
env
__pycache__
*.py[cod]
.ruff_cache
.mypy_cache
.pytest_cache
.dmypy.json
dmypy.json
htmlcov
.coverage
.coverage.*
*.cover
coverage.json
coverage.xml
*.egg-info
*.egg
build
dist
tests
tools
openspec
docs
*.md
!README.md
Dockerfile
.dockerignore
# Local CI artifacts (planlint's own dogfooding output, never shipped)
spec-graph.json
spec-findings.json
head.json
base.json
# Editor / OS
.idea
.vscode
*.swp
.DS_Store

# Agent-facing distribution artifacts: shipped through the git repo (the plugin
# marketplace installs from the repo, not from an image), never needed in a
# build context. Keeping them out also keeps the image free of prose that would
# drift from the installed CLI.
skills
evals
.claude
.claude-plugin
context7.json
llms.txt
